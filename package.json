{
  "name": "n8n-nodes-lifespace",
  "version": "0.1.0",
  "description": "Official n8n community nodes for integrating workflows and AI agents with LifeSpace.",
  "license": "MIT",
  "homepage": "https://github.com/huangshirui/lifespace-n8n-nodes",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "lifespace",
    "automation",
    "workflow"
  ],
  "author": {
    "name": "Shirui Huang",
    "email": "3366046+huangshirui@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huangshirui/lifespace-n8n-nodes.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/LifeSpaceApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LifeSpace/LifeSpace.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
